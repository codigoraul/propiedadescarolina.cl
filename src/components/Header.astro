---
import { u } from '../lib/url';
import { waLink } from '../lib/wp';
const path = Astro.url.pathname.replace(u(""), "") || "/";
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/propiedades/', label: 'Propiedades' },
  { href: '/propiedades/?operacion=venta', label: 'En venta' },
  { href: '/propiedades/?operacion=arriendo', label: 'En arriendo' },
  { href: '/nosotros/', label: 'Nosotros' },
  { href: '/contacto/', label: 'Contacto' },
];
const activo = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.split('?')[0]) && !href.includes('?'));
---
<header class="sticky top-0 z-40 bg-[rgba(28,28,28,0.85)] text-crema-100 backdrop-blur">
  <div class="container-site flex h-20 items-center justify-between gap-6">
    <a href={u("/")} class="flex shrink-0 items-center" aria-label="Carolina Robles Propiedades — Inicio">
      <img src={u("/img/logo-horizontal.png")} alt="Carolina Robles Propiedades" width="845" height="165" class="h-12 w-auto md:h-14" />
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium lg:flex" aria-label="Principal">
      {links.map((l) => (
        <a href={u(l.href)} class:list={['transition-colors hover:text-oro-400', activo(l.href) ? 'text-oro-400' : 'text-crema-100/85']}>{l.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={waLink('Hola Carolina, quiero información sobre propiedades')} target="_blank" rel="noopener" class="btn-primary !py-2.5">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.05 0C5.5 0 .2 5.3.2 11.85c0 2.1.55 4.13 1.6 5.93L0 24l6.4-1.68a11.8 11.8 0 0 0 5.65 1.44c6.55 0 11.85-5.3 11.85-11.85 0-3.17-1.23-6.15-3.4-8.4zm-8.45 18.2c-1.77 0-3.5-.48-5.02-1.38l-.36-.21-3.8 1 1.02-3.7-.24-.38a9.84 9.84 0 0 1-1.5-5.2c0-5.43 4.42-9.85 9.86-9.85 2.63 0 5.1 1.03 6.96 2.9a9.8 9.8 0 0 1 2.88 6.96c0 5.44-4.42 9.86-9.8 9.86zm5.4-7.37c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.66-1.6-.9-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35z"/></svg>
        WhatsApp
      </a>
    </div>

    <button id="nav-toggle" class="rounded-lg p-2 text-crema-100 lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-mobile">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <div id="nav-mobile" hidden class="border-t border-crema-100/10 bg-[#1c1c1c] lg:hidden">
    <nav class="container-site flex flex-col py-5 text-lg font-medium" aria-label="Móvil">
      {links.map((l) => <a href={u(l.href)} class="border-b border-crema-100/10 py-4 text-crema-100/90 hover:text-oro-400">{l.label}</a>)}
      <a href={waLink('Hola Carolina, quiero información sobre propiedades')} target="_blank" rel="noopener" class="btn-primary mt-6 mb-3 !py-4 text-base">Escríbenos por WhatsApp</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = menu!.hidden;
    menu!.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
