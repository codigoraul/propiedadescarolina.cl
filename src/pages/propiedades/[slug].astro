---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { getPropiedades, precio, ubicacion, TIPO_LABEL, OPERACION_LABEL, waLink, type Propiedad } from '../../lib/wp';

export async function getStaticPaths() {
  const todas = await getPropiedades();
  return todas.map((p) => ({ params: { slug: p.slug }, props: { p, todas } }));
}
const { p, todas } = Astro.props as { p: Propiedad; todas: Propiedad[] };
const $ = precio(p);
const similares = todas.filter((x) => x.id !== p.id && x.operacion === p.operacion && (x.tipo === p.tipo || x.ciudad === p.ciudad)).slice(0, 3);
const fotos = p.galeria;
const url = new URL(u(`/propiedades/${p.slug}/`), Astro.site).href;
const waMsg = `Hola Carolina, me interesa la propiedad "${p.titulo}" (${p.codigo}) ${url}`;
const mapaUrl = p.mapa ? `https://www.google.com/maps?q=${p.mapa.lat},${p.mapa.lng}&z=15&output=embed` : `https://www.google.com/maps?q=${encodeURIComponent([p.direccion, p.ciudad, 'Chile'].filter(Boolean).join(', '))}&z=14&output=embed`;
const ytId = p.videoUrl.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/)?.[1];

const datos: [string, string | number | null][] = [
  ['Operación', OPERACION_LABEL[p.operacion]],
  ['Tipo', TIPO_LABEL[p.tipo]],
  ['Dormitorios', p.dormitorios],
  ['Baños', p.banos],
  ['Estacionamientos', p.estacionamientos],
  ['m² construidos', p.m2Construidos],
  ['m² terreno', p.m2Terreno],
  ['Piso', p.piso],
  ['Antigüedad', p.antiguedad === 'nueva' ? 'Nueva' : p.antiguedad === 'usada' ? 'Usada' : null],
  ['Comuna', p.ciudad || null],
  ['Sector', p.sector && p.sector !== p.ciudad ? p.sector : null],
  ['Código', p.codigo || null],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: p.titulo, url, image: fotos.map((f) => f.url), description: p.descripcion.replace(/<[^>]+>/g, ' ').trim().slice(0, 300),
  datePosted: p.fecha,
  offers: { '@type': 'Offer', price: p.precioPesos ?? p.precioUf ?? undefined, priceCurrency: p.precioPesos ? 'CLP' : 'UF', availability: 'https://schema.org/InStock' },
  address: { '@type': 'PostalAddress', streetAddress: p.direccion, addressLocality: p.ciudad, addressRegion: 'Región Metropolitana', addressCountry: 'CL' },
};
---
<Base title={`${p.titulo} · ${OPERACION_LABEL[p.operacion]} en ${p.ciudad || 'Talagante'} · Carolina Robles Propiedades`}
      description={`${TIPO_LABEL[p.tipo]} ${OPERACION_LABEL[p.operacion].toLowerCase()} en ${ubicacion(p)}. ${$.valor}${$.sufijo}. ${p.dormitorios ? p.dormitorios + ' dormitorios, ' : ''}${p.banos ? p.banos + ' baños. ' : ''}`}
      image={p.imagen?.large}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Galería -->
  <section class="bg-carbon-900">
    <div class="container-site py-4">
      <nav class="mb-3 text-xs text-crema-100/60" aria-label="Migas">
        <a href={u("/")} class="hover:text-oro-400">Inicio</a> · <a href={u("/propiedades/")} class="hover:text-oro-400">Propiedades</a> · <span class="text-crema-100/90">{p.titulo}</span>
      </nav>
      <div class="grid gap-2 md:grid-cols-4 md:grid-rows-2 md:h-[520px]">
        {fotos.slice(0, 5).map((f, i) => (
          <button type="button" data-idx={i} class:list={['lb-open relative block overflow-hidden rounded-xl bg-carbon-800', i === 0 ? 'md:col-span-2 md:row-span-2 aspect-[4/3] md:aspect-auto' : 'hidden md:block']}>
            <img src={i === 0 ? f.large : f.medium} alt={f.alt || `${p.titulo} foto ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} class="h-full w-full object-cover transition hover:scale-105" />
            {i === 4 && fotos.length > 5 && <span class="absolute inset-0 flex items-center justify-center bg-carbon-900/60 text-lg font-semibold text-crema-100">+{fotos.length - 5} fotos</span>}
          </button>
        ))}
      </div>
      <button type="button" data-idx="0" class="lb-open mt-3 text-sm text-oro-400 hover:underline">Ver las {fotos.length} fotos</button>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_360px]">
      <div>
        <div class="flex flex-wrap gap-2">
          <span class:list={['chip text-white', p.operacion === 'venta' ? 'bg-verde-600' : 'bg-oro-600']}>{OPERACION_LABEL[p.operacion]}</span>
          <span class="chip bg-crema-200 text-carbon-800">{TIPO_LABEL[p.tipo]}</span>
          {p.destacada && <span class="chip bg-carbon-900 text-oro-400">Destacada</span>}
        </div>
        <h1 class="mt-4 text-3xl md:text-4xl">{p.titulo}</h1>
        <p class="mt-2 flex items-center gap-2 text-carbon-800/70">
          <svg class="h-4 w-4 text-oro-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          {[p.direccion, ubicacion(p)].filter(Boolean).join(' · ')}
        </p>
        <p class="mt-5 text-3xl font-bold text-verde-700">{$.valor}<span class="text-base font-medium text-carbon-800/50">{$.sufijo}</span></p>

        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 rounded-2xl bg-white p-6 ring-1 ring-carbon-800/5 sm:grid-cols-3">
          {datos.filter(([, v]) => v !== null && v !== undefined && v !== '').map(([k, v]) => (
            <div><dt class="text-xs uppercase tracking-wider text-carbon-800/50">{k}</dt><dd class="mt-1 font-semibold">{v}</dd></div>
          ))}
        </dl>

        {p.amenidades.length > 0 && (
          <div class="mt-8">
            <h2 class="text-xl">Amenidades</h2>
            <ul class="mt-3 flex flex-wrap gap-2">{p.amenidades.map((a) => <li class="chip bg-verde-50 text-verde-800 capitalize">{a}</li>)}</ul>
          </div>
        )}

        {p.descripcion && (
          <div class="mt-8">
            <h2 class="text-xl">Descripción</h2>
            <div class="prose-wp mt-3 text-carbon-800/85" set:html={p.descripcion} />
          </div>
        )}

        {ytId && (
          <div class="mt-8">
            <h2 class="text-xl">Video</h2>
            <div class="mt-3 aspect-video overflow-hidden rounded-2xl"><iframe class="h-full w-full" src={`https://www.youtube-nocookie.com/embed/${ytId}`} title="Video de la propiedad" loading="lazy" allowfullscreen></iframe></div>
          </div>
        )}

        <div class="mt-8">
          <h2 class="text-xl">Ubicación</h2>
          <div class="mt-3 aspect-[16/9] overflow-hidden rounded-2xl bg-crema-200 md:aspect-[21/9]">
            <iframe class="h-full w-full" src={mapaUrl} title={`Mapa: ${ubicacion(p)}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>

      <!-- Sidebar contacto -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-2xl bg-white p-6 shadow-lg shadow-black/5 ring-1 ring-carbon-800/5">
          <div class="flex items-center gap-4">
            {p.corredor.foto ? <img src={p.corredor.foto.medium} alt={p.corredor.nombre} class="h-14 w-14 rounded-full object-cover" /> : <div class="flex h-14 w-14 items-center justify-center rounded-full bg-verde-100 text-xl font-bold text-verde-700">{p.corredor.nombre.charAt(0)}</div>}
            <div>
              <p class="font-semibold">{p.corredor.nombre}</p>
              <p class="text-sm text-carbon-800/60">Corredora de propiedades</p>
            </div>
          </div>
          <a href={waLink(waMsg)} target="_blank" rel="noopener" class="btn-whatsapp mt-6 w-full">Consultar por WhatsApp</a>
          <a href={`tel:${p.corredor.telefono.replace(/\s/g, '')}`} class="btn-outline mt-3 w-full">Llamar {p.corredor.telefono}</a>

          <p id="form-ok" hidden class="mt-6 rounded-xl bg-verde-50 p-3 text-sm text-verde-800">Gracias, recibimos tu consulta. Te contactaremos a la brevedad.</p>
          <p id="form-error" hidden class="mt-6 rounded-xl bg-red-50 p-3 text-sm text-red-800">No pudimos enviar el mensaje. Usa WhatsApp o llámanos.</p>
          <form id="form-contacto" action={u("/contacto.php")} method="post" class="mt-6 space-y-3 border-t border-carbon-800/10 pt-6">
            <input type="hidden" name="propiedad" value={`${p.titulo} (${p.codigo}) ${url}`} />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
            <input class="field" type="text" name="nombre" placeholder="Nombre" required />
            <input class="field" type="email" name="email" placeholder="Email" required />
            <input class="field" type="tel" name="telefono" placeholder="Teléfono" />
            <textarea class="field" name="mensaje" rows="3" required>Hola, me interesa esta propiedad. ¿Podemos coordinar una visita?</textarea>
            <button type="submit" class="btn-primary w-full">Enviar consulta</button>
          </form>
        </div>
      </aside>
    </div>
  </section>

  {similares.length > 0 && (
    <section class="bg-crema-100 py-14">
      <div class="container-site">
        <p class="eyebrow">También te puede interesar</p>
        <h2 class="mt-2 text-2xl md:text-3xl">Propiedades similares</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{similares.map((s) => <PropertyCard p={s} />)}</div>
      </div>
    </section>
  )}

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox fixed inset-0 z-[60] flex flex-col bg-carbon-900/95 text-crema-100" hidden role="dialog" aria-modal="true" aria-label="Galería de fotos">
    <div class="flex items-center justify-between px-5 py-4 text-sm">
      <span id="lb-count"></span>
      <button type="button" id="lb-close" class="rounded-full p-2 hover:bg-white/10" aria-label="Cerrar"><svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="relative flex flex-1 items-center justify-center px-14">
      <button type="button" id="lb-prev" class="absolute left-3 rounded-full bg-white/10 p-3 hover:bg-white/20" aria-label="Anterior"><svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M15 6l-6 6 6 6"/></svg></button>
      <img id="lb-img" src="" alt="" class="max-h-[80vh] max-w-full rounded-lg object-contain" />
      <button type="button" id="lb-next" class="absolute right-3 rounded-full bg-white/10 p-3 hover:bg-white/20" aria-label="Siguiente"><svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
  <script type="application/json" id="lb-data" set:html={JSON.stringify(fotos.map((f) => ({ url: f.url, alt: f.alt })))} />
</Base>

<script>
  const fotos: { url: string; alt: string }[] = JSON.parse(document.getElementById('lb-data')!.textContent || '[]');
  const lb = document.getElementById('lightbox')!;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const count = document.getElementById('lb-count')!;
  let i = 0;
  const show = (n: number) => { i = (n + fotos.length) % fotos.length; img.src = fotos[i].url; img.alt = fotos[i].alt; count.textContent = `${i + 1} / ${fotos.length}`; };
  const open = (n: number) => { show(n); lb.hidden = false; document.body.style.overflow = 'hidden'; };
  const close = () => { lb.hidden = true; document.body.style.overflow = ''; };
  document.querySelectorAll<HTMLElement>('.lb-open').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.idx || 0))));
  document.getElementById('lb-close')!.addEventListener('click', close);
  document.getElementById('lb-prev')!.addEventListener('click', () => show(i - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => show(i + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => { if (lb.hidden) return; if (e.key === 'Escape') close(); if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
  let x0 = 0; lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true }); lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1); });
</script>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement;
  const ok = document.getElementById('form-ok')!, err = document.getElementById('form-error')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Enviando…';
    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!(await r.json()).ok) throw new Error('error');
      ok.hidden = false; err.hidden = true; form.reset();
    } catch { err.hidden = false; ok.hidden = true; }
    btn.disabled = false; btn.textContent = 'Enviar consulta';
  });
</script>
