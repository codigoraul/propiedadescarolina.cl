---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · Carolina Robles Propiedades">
  <section class="container-site py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-3xl md:text-4xl">Esta página no existe</h1>
    <p class="mt-4 text-carbon-800/70">Puede que la propiedad ya no esté disponible.</p>
    <a href={u("/propiedades/")} class="btn-primary mt-8">Ver propiedades disponibles</a>
  </section>
</Base>
