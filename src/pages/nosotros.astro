---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { waLink } from '../lib/wp';
const valores = [
  { t: 'Transparencia', d: 'Precios reales, información completa y sin letra chica en cada operación.' },
  { t: 'Cercanía', d: 'Atención directa de Carolina, sin intermediarios ni call centers.' },
  { t: 'Conocimiento local', d: '18 años trabajando en Talagante, Peñaflor, Isla de Maipo y Padre Hurtado.' },
  { t: 'Rapidez', d: 'Buscamos cerrar en el menor plazo posible, cuidando el valor de tu propiedad.' },
];
const pasos = [
  ['Evaluación', 'Visitamos la propiedad, revisamos la documentación y definimos juntos el precio de mercado.'],
  ['Publicación', 'Fotografías profesionales, ficha completa y difusión en este sitio y los principales portales.'],
  ['Visitas y selección', 'Coordinamos visitas, filtramos interesados y verificamos antecedentes comerciales.'],
  ['Cierre', 'Acompañamiento en promesa, escritura o contrato de arriendo hasta la entrega de llaves.'],
];
---
<Base title="Nosotros · Corredora de Propiedades con 18 Años en Talagante | Carolina Robles" description="Carolina Robles, corredora de propiedades en Talagante desde 2008. Asesoría completa para vender o arrendar tu casa, parcela o terreno: tasación, publicación, visitas y cierre.">
  <section class="bg-carbon-900 py-16 text-crema-100 md:py-20">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow text-oro-400">Nosotros</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight md:text-5xl">18 años ayudando a familias a encontrar su lugar</h1>
        <p class="mt-6 text-lg leading-relaxed text-crema-100/80">Carolina Robles Propiedades es una corredora con 18 años de experiencia. Nuestro objetivo es brindar los más altos estándares a todos nuestros clientes, con asesoría durante todo el proceso de arriendo o compraventa: mantenemos la propiedad en buen estado, conseguimos un buen arrendatario o comprador y cerramos a la mayor brevedad.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={u("/propiedades/")} class="btn-gold">Ver propiedades</a>
          <a href={waLink('Hola Carolina, quiero conversar sobre mi propiedad')} target="_blank" rel="noopener" class="btn border border-crema-100/30 text-crema-100 hover:border-oro-400 hover:text-oro-400">Conversemos</a>
        </div>
      </div>
      <img src={u("/img/nosotros-entrega-llaves.webp")} alt="Entrega de llaves de una casa" width="990" height="659" loading="eager" class="aspect-[3/2] w-full rounded-3xl object-cover shadow-2xl" />
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="container-site">
      <p class="eyebrow">Nuestros valores</p>
      <h2 class="mt-2 text-3xl md:text-4xl">Cómo trabajamos</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {valores.map((v) => (
          <div class="rounded-2xl bg-white p-6 ring-1 ring-carbon-800/5">
            <div class="h-1.5 w-10 rounded-full bg-oro-500"></div>
            <h3 class="mt-4 text-lg">{v.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-carbon-800/70">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-verde-900 py-16 text-crema-100 md:py-20">
    <div class="container-site">
      <p class="eyebrow text-oro-400">Proceso</p>
      <h2 class="mt-2 text-3xl md:text-4xl">De la evaluación a la entrega de llaves</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {pasos.map(([t, d], i) => (
          <li class="rounded-2xl border border-crema-100/10 bg-white/5 p-6">
            <span class="font-serif text-4xl text-oro-400">0{i + 1}</span>
            <h3 class="mt-3 text-lg">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-crema-100/70">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-16">
    <div class="container-site rounded-3xl bg-oro-500 px-8 py-12 text-center text-carbon-900 md:px-16">
      <h2 class="text-2xl md:text-3xl">¿Conversamos sobre tu propiedad?</h2>
      <p class="mx-auto mt-3 max-w-xl text-carbon-900/75">Evaluación sin costo. Te decimos con claridad cuánto vale y cuál es la mejor estrategia para venderla o arrendarla.</p>
      <a href={u("/contacto/")} class="btn mt-7 bg-carbon-900 text-crema-100 hover:bg-carbon-800">Contactar</a>
    </div>
  </section>
</Base>
