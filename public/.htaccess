# Sitio Astro estático en la raíz. /admin es el WordPress headless (tiene su propio .htaccess).

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS (sin tocar /admin)
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirecciones del sitio viejo (Houzez) -> sitio nuevo
RewriteRule ^propiedad/([^/]+)/?$ /propiedades/$1/ [R=301,L]
RewriteRule ^property/([^/]+)/?$ /propiedades/$1/ [R=301,L]
RewriteRule ^(?:en-venta|estado/en-venta|status/en-venta|property-status/en-venta)/?$ /propiedades/?operacion=venta [R=301,L,QSD]
RewriteRule ^(?:en-arriendo|estado/en-arriendo|status/en-arriendo|property-status/en-arriendo)/?$ /propiedades/?operacion=arriendo [R=301,L,QSD]
RewriteRule ^(?:tipo|property-type)/casas?/?$ /propiedades/?tipo=casa [R=301,L,QSD]
RewriteRule ^(?:tipo|property-type)/departamentos?/?$ /propiedades/?tipo=departamento [R=301,L,QSD]
RewriteRule ^(?:tipo|property-type)/terrenos?/?$ /propiedades/?tipo=terreno [R=301,L,QSD]
RewriteRule ^(?:tipo|property-type)/(?:comercial|oficinas?|comercial-oficinas)/?$ /propiedades/?tipo=comercial [R=301,L,QSD]

# Páginas sin barra final -> con barra (excepto /admin y archivos)
RewriteCond %{REQUEST_URI} !^/admin
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# Compresión
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Caché: assets con hash de Astro e imágenes largos; HTML siempre revalidado
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
